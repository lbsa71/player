{
  "$defs": {
    "CatalogSummary": {
      "properties": {
        "analysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "audio_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "available": {
          "type": "boolean"
        },
        "duration_seconds": {
          "format": "double",
          "type": "number"
        },
        "override_revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "track_id": {
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "audio_hash",
        "duration_seconds",
        "available",
        "override_revision"
      ],
      "type": "object"
    },
    "ContentHash": {
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/HashAlgorithm"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "type": "object"
    },
    "FileRef": {
      "properties": {
        "hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "hash"
      ],
      "type": "object"
    },
    "HashAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "shard_id": {
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/CatalogSummary"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "shard_id",
    "tracks"
  ],
  "title": "CatalogShard",
  "type": "object"
}