{
  "$defs": {
    "ContentHash": {
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/HashAlgorithm"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "type": "object"
    },
    "HashAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "JobState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "deferred"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "audio_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "diagnostic": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "job_id": {
      "type": "string"
    },
    "retry_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "stage": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "track_id": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "track_id",
    "audio_hash",
    "state",
    "stage",
    "retry_count",
    "updated_at"
  ],
  "title": "Job",
  "type": "object"
}