{
  "$defs": {
    "ContentHash": {
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/HashAlgorithm"
        },
        "digest": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "type": "object"
    },
    "FileRef": {
      "properties": {
        "hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "hash"
      ],
      "type": "object"
    },
    "HashAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "ModelAsset": {
      "properties": {
        "attribution": {
          "type": "string"
        },
        "code_license": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/FileRef"
        },
        "model_id": {
          "type": "string"
        },
        "redistribution": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "upstream_url": {
          "type": "string"
        },
        "weight_license": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "file",
        "upstream_url",
        "revision",
        "code_license",
        "weight_license",
        "attribution",
        "redistribution"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "manifest_id": {
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelAsset"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "models"
  ],
  "title": "ModelManifest",
  "type": "object"
}