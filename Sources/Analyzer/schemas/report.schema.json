      },
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "default": {},
      "type": "object"
    },
    "kind": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "kind",
    "counts",
    "diagnostics",
    "created_at"
  ],
  "title": "Report",
  "type": "object"
}