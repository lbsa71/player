      "type": "string"
    },
    "records": {
      "additionalProperties": true,
      "type": "object"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "shared_from": {
